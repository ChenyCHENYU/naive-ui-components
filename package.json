{
  "name": "@robot-admin/naive-ui-components",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.11.1",
  "description": "基于 Naive UI 的 Vue 3 组件库",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.14"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "require": "./dist/resolver.cjs"
    },
    "./C_*": {
      "types": "./dist/C_*.d.ts",
      "import": "./dist/C_*.js",
      "require": "./dist/C_*.cjs"
    },
    "./C_*/style.css": "./dist/C_*.css",
    "./C_Form/base.css": "./dist/C_Form.base.css",
    "./C_Form/full.css": "./dist/C_Form.css",
    "./C_Table/base.css": "./dist/C_Table.base.css",
    "./C_Table/full.css": "./dist/C_Table.css"
  },
  "sideEffects": [
    "dist/style.css",
    "dist/C_*.css",
    "dist/C_*.base.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "components",
    "naive-ui",
    "typescript",
    "ui-library"
  ],
  "author": "CHENY <ycyplus@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ChenyCHENYU/naive-ui-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/naive-ui-components.git"
  },
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/naive-ui-components/issues"
  },
  "scripts": {
    "dev": "node scripts/watch-global-scss.js & tsdown --watch",
    "build:scss": "node scripts/gen-global-scss.js && sass src/styles/global.scss dist/global-scss.css --style=compressed --no-source-map --load-path=src --silence-deprecation=legacy-js-api",
    "build:css": "node scripts/merge-css.js",
    "build:exports": "node scripts/gen-exports.js",
    "build": "tsdown && bun run build:scss && bun run build:css && bun run build:exports && bun run check:dist && bun run check:size",
    "type-check": "tsc --noEmit",
    "test": "bun test tests",
    "check:exports": "node scripts/check-export-conflicts.js",
    "check:dist": "node scripts/check-dist-entries.js",
    "check:size": "node scripts/check-size-budget.js",
    "check:audit": "bun audit",
    "check:package": "node scripts/check-package-contract.js",
    "check:quality": "node scripts/check-source-quality.js",
    "check:consumer-types": "vue-tsc --noEmit -p tests/consumer/tsconfig.json",
    "verify": "bun run lint:check && bun run type-check && bun run test && bun run check:exports && bun run check:package && bun run check:quality && bun run build && bun run check:consumer-types",
    "prepublishOnly": "bun run verify",
    "release": "changeset publish",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "node node_modules/husky/bin.js",
    "cz": "git-cz",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore && eslint . --no-fix",
    "lint:eslint": "eslint . --no-fix",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "naive-ui": "^2.35.0",
    "vue-router": "^4.6.4",
    "sortablejs": "^1.15.7"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    },
    "sortablejs": {
      "optional": true
    }
  },
  "dependencies": {
    "@antv/x6": "^2.19.2",
    "@chenfengyuan/vue-barcode": "^2.0.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@iconify/vue": "^5.0.1",
    "@visactor/vtable": "^1.26.7",
    "@visactor/vtable-gantt": "^1.26.7",
    "@vue-flow/core": "^1.48.2",
    "@wangeditor-next/editor": "6.2.0",
    "@wangeditor-next/editor-for-vue": "6.2.0",
    "dompurify": "^3.4.14",
    "driver.js": "^1.8.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.2",
    "md-editor-v3": "6.5.6",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.4",
    "spark-md5": "^3.0.2",
    "vue-cropper": "^1.1.4",
    "vue-draggable-plus": "^0.6.1",
    "vue3-puzzle-vcode": "^1.1.7",
    "xgplayer": "3.0.26",
    "xgplayer-hls": "3.0.26",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@robot-admin/git-standards": "1.0.3",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-core": "^3.3.11",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "naive-ui": "^2.45.3",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "defu": "6.1.7",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimist": "1.2.8",
    "protocol-buffers-schema": "3.6.1",
    "tmp": "0.2.7",
    "yaml": "2.9.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "oxlint --max-warnings 0 --deny-warnings",
      "eslint --fix --no-cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
